# Copy to .env for `docker-compose up`. docker-compose reads this file automatically.
# These are REQUIRED — the stack refuses to start without them.

# PostgreSQL password (used by both the database and the backend).
DB_PASSWORD=

# JWT signing secret. MUST be a random string of at least 32 characters.
# Generate one with, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
