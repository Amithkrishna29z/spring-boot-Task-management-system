# API Configuration
# Leave EMPTY for same-origin (recommended): the Vite dev server and the nginx prod image
# both proxy /api to the backend, which keeps the auth cookies first-party. Only set an
# absolute URL if the API is served from a genuinely different origin.
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false

# Application Settings
VITE_APP_NAME=Task Manager
VITE_PAGINATION_DEFAULT_SIZE=10
VITE_PAGINATION_MAX_SIZE=100
