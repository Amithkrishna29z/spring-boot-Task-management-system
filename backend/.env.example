# Backend secrets/credentials. Copy this file to `.env` (same folder) and fill in real
# values. The dev/local/prod Spring profiles load it automatically via spring.config.import.
# `.env` is gitignored — NEVER commit real secrets.

# Database
DB_URL=jdbc:postgresql://localhost:5432/taskdb
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing secret — must be at least 32 characters (HMAC-SHA256).
# Generate one with, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Optional overrides (sensible defaults already exist in application.yml):
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SERVER_PORT=8080
